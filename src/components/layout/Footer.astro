---
import { Image } from "astro:assets";
import capybara from "../../assets/images/logo/capybara.png";

const year = new Date().getFullYear();

const links = [
  { href: "/faq", label: "FAQ" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/#focus-pro", label: "Focus Pro" }
];
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-12 text-center">
    <Image src={capybara} alt="Focus Pet" width={32} height={30} class="h-8 w-auto" />

    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
      {links.map((link) => (
        <a href={link.href} class="font-heading text-sm font-semibold no-underline hover:text-accent-blue">
          {link.label}
        </a>
      ))}
    </nav>

    <p class="text-sm text-text-secondary">
      &copy; {year} Focus Pet. A cozy companion for focusing well.
    </p>
  </div>
</footer>
