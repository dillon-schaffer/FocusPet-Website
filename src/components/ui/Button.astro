---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline";
  class?: string;
  [key: string]: any;
}

const { href, variant = "primary", class: className = "", ...rest } = Astro.props;

const variantClasses: Record<string, string> = {
  primary: "bg-accent-orange hover:bg-accent-orange/90",
  secondary: "bg-accent-green hover:bg-accent-green/90",
  outline: "bg-transparent border-2 border-border hover:bg-surface",
};

const base =
  "inline-flex items-center justify-center gap-2 rounded-button px-6 py-3 font-heading font-bold text-text-primary no-underline transition-colors";

const classes = `${base} ${variantClasses[variant]} ${className}`;
const Tag = href ? "a" : "button";
---

<Tag class={classes} href={href} {...rest}>
  <slot />
</Tag>
