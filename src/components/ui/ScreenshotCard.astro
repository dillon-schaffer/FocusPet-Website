---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<div class="overflow-hidden rounded-image shadow-soft">
  <Image src={image} alt={alt} class="h-auto w-full" />
</div>
