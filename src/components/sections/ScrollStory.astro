---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import startImg from "../../../images/Start.png";
import laterImg from "../../../images/20HoursLater.png";
import setupImg from "../../../images/FocusSetup.png";
import sessionImg from "../../../images/FocusSession.png";
import distractedImg from "../../../images/Distractedv2.png";
import successImg from "../../../images/SuccessfulSession.png";
import poolImg from "../../../images/Pool.png";

const slides = [
  {
    image: startImg,
    alt: "The Focus Pet app open on the backyard screen, with the capybara pet standing next to the Focus button",
    headline: "A cozy desktop companion that grows while you focus.",
    caption: "A distraction-free focus timer, paired with a relaxing virtual pet.",
    cta: true,
  },
  {
    image: laterImg,
    alt: "The same backyard filled with an apple tree, bushes, and new decorations after many completed focus sessions",
    headline: "Watch your space grow over time.",
    caption: "The longer you focus, the cozier your backyard becomes.",
  },
  {
    image: setupImg,
    alt: "The focus setup screen, showing a 25 minute timer, focus mode, and an allow list of apps and sites",
    headline: "Choose how you want to focus.",
    caption: "Pick your timer, focus mode, and what to block out.",
  },
  {
    image: sessionImg,
    alt: "A focus session in progress, with the capybara peacefully sleeping on a rock in a decorated backyard",
    headline: "Focus together.",
    caption: "While you work, your capybara rests peacefully beside you.",
  },
  {
    image: distractedImg,
    alt: "A browser notification showing the Focus Pet capybara startled after a distracting site was visited during a focus session",
    headline: "Gentle accountability.",
    caption: "Get distracted, earn less Energy. Your pet gets startled, reminding you to stay on track.",
  },
  {
    image: successImg,
    alt: "A completed focus session screen, showing +5 Energy earned and the pet celebrating",
    headline: "Every session earns something.",
    caption: "Complete sessions to earn Energy and unlock new decorations.",
  },
  {
    image: poolImg,
    alt: "The Pool area, fully decorated with a palm tree, lounge chair, tiki torches, and pool floats",
    headline: "Unlock entirely new areas.",
    caption: "Gradually expand your world with entirely new places to decorate.",
  },
];
---

<section
  id="story"
  class="story-track relative"
  style={`height: ${slides.length * 100}vh`}
  data-scroll-story
>
  <div class="story-pin sticky top-20 h-[calc(100vh-5rem)] overflow-hidden">
    {slides.map((slide, i) => (
      <div class="story-slide absolute inset-0 flex flex-col items-center justify-center px-6 text-center" data-slide>
        <div class="overflow-hidden rounded-image shadow-soft">
          <Image
            src={slide.image}
            alt={slide.alt}
            class="h-auto max-h-[52vh] max-w-[85vw] w-auto object-contain md:max-h-[62vh] md:max-w-[78vw]"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
          />
        </div>
        <h2 class="mt-5 max-w-3xl text-3xl font-extrabold leading-tight md:text-5xl">
          {slide.headline}
        </h2>
        <p class="mt-2 max-w-xl text-base text-text-secondary md:mt-3 md:text-xl">{slide.caption}</p>
        {slide.cta && (
          <div class="mt-5">
            <Button
              href="https://github.com/dillon-schaffer/FocusPet-Releases/releases/latest"
              variant="primary"
              data-download-button
            >
              Download for Windows
            </Button>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .story-slide {
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
  }

  .story-slide.is-active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .story-track {
      height: auto !important;
    }

    .story-pin {
      position: static !important;
      height: auto !important;
    }

    .story-slide {
      position: relative !important;
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
      padding-block: 3rem;
    }
  }
</style>

<script>
  function initScrollStory() {
    const root = document.querySelector("[data-scroll-story]");
    if (!(root instanceof HTMLElement)) return;

    const isDesktop = window.matchMedia("(min-width: 768px)").matches;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!isDesktop || reduceMotion) return;

    const pin = root.querySelector(".story-pin");
    const slides = Array.from(root.querySelectorAll("[data-slide]"));
    const total = slides.length;
    if (!(pin instanceof HTMLElement) || total === 0) return;

    slides[0].classList.add("is-active");

    let ticking = false;

    function update() {
      const el = root as HTMLElement;
      const pinEl = pin as HTMLElement;
      const rect = el.getBoundingClientRect();
      const scrollable = el.offsetHeight - pinEl.offsetHeight;
      const progress = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0;
      let activeIndex = Math.floor(progress * total);
      if (activeIndex >= total) activeIndex = total - 1;
      if (activeIndex < 0) activeIndex = 0;

      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === activeIndex);
      });

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScrollStory);
  } else {
    initScrollStory();
  }
</script>
