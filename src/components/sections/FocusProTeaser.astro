---
const highlights = [
  { label: "Closes distracting apps", icon: "block" },
  { label: "Blocks tempting sites", icon: "globe" },
  { label: "Earns bonus Strength", icon: "fist" },
];
---

<section id="focus-pro" class="border-t border-border">
  <div class="mx-auto max-w-3xl px-6 py-20 md:py-24">
    <div class="focus-pro-panel rounded-card p-8 shadow-soft md:p-12">
      <span class="focus-pro-kicker">Optional upgrade</span>
      <h2 class="mt-3 text-3xl font-extrabold md:text-4xl">Focus Pro</h2>

      <p class="mt-5 max-w-xl text-lg text-text-secondary md:text-xl">
        Some sessions you already know you're going to cave — a dozen tabs open, phone face-up on the desk.
      </p>
      <p class="mt-4 max-w-xl text-text-secondary">
        Deep Focus is the extra lock for those. It shuts the distracting apps, blocks the tempting sites, and pays
        out bonus Strength for sticking it out. Everything else about Focus Pet works exactly the same without it —
        free was always meant to be the whole experience.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {highlights.map((item) => (
          <span class="focus-pro-chip">
            <span aria-hidden="true">
              {item.icon === "block" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <circle cx="12" cy="12" r="8.5" />
                  <path d="m6.3 6.3 11.4 11.4" />
                </svg>
              )}
              {item.icon === "globe" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <circle cx="12" cy="12" r="8.5" />
                  <path d="M3.5 12h17M12 3.5c2.4 2.3 3.7 5.2 3.7 8.5s-1.3 6.2-3.7 8.5c-2.4-2.3-3.7-5.2-3.7-8.5S9.6 5.8 12 3.5Z" />
                </svg>
              )}
              {item.icon === "fist" && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 10.5V8a1.6 1.6 0 0 1 3.2 0v2M10.2 10V7.2a1.6 1.6 0 0 1 3.2 0V10M13.4 10.2V7.8a1.6 1.6 0 0 1 3.2 0v5.7c0 3.3-2.2 6-5.9 6-3 0-4.4-1.2-5.7-3.3L3.2 12.8a1.4 1.4 0 0 1 2.3-1.6L7 13" />
                </svg>
              )}
            </span>
            {item.label}
          </span>
        ))}
      </div>

      <p class="mt-8 text-sm text-text-secondary">Totally optional — the free version is already the whole Focus Pet experience.</p>
    </div>
  </div>
</section>

<style>
  .focus-pro-panel {
    background: linear-gradient(155deg, theme(colors.surface) 0%, theme(colors.background) 100%);
    border: 1px solid theme(colors.border);
  }

  .focus-pro-kicker {
    display: inline-block;
    font-family: theme(fontFamily.heading);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: theme(colors.accent-orange);
  }

  .focus-pro-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: theme(borderRadius.pill);
    background: theme(colors.surface);
    border: 1px solid theme(colors.border);
    padding: 0.55rem 1rem;
    font-family: theme(fontFamily.heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: theme(colors.text-primary);
  }

  .focus-pro-chip svg {
    height: 1.05rem;
    width: 1.05rem;
    color: theme(colors.accent-orange);
  }
</style>
