---
const highlights = [
  {
    title: "Closes distracting apps",
    description: "The apps you choose close the moment a session starts and stay closed until it ends.",
  },
  {
    title: "Blocks tempting sites",
    description: "Selected websites stay unreachable for the whole session, so staying on task isn't down to willpower.",
  },
  {
    title: "Earns bonus Strength",
    description: "Distraction-free sessions pay out extra Strength, on top of the Energy every session already earns.",
  },
];
---

<section id="focus-pro" class="border-t border-border">
  <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <span class="focus-pro-kicker">Optional upgrade</span>
    <h2 class="mt-3 text-3xl font-extrabold md:text-4xl">Focus Pro</h2>

    <div class="mt-10 divide-y divide-border border-t border-border">
      {highlights.map((item) => (
        <div class="grid gap-x-8 gap-y-1 py-6 md:grid-cols-[minmax(0,220px)_1fr]">
          <h3 class="font-heading text-lg font-bold md:text-xl">{item.title}</h3>
          <p class="text-text-secondary">{item.description}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-sm text-text-secondary">
      Completely optional — the free version is already the full Focus Pet experience.
    </p>
  </div>
</section>

<style>
  .focus-pro-kicker {
    display: inline-block;
    font-family: theme(fontFamily.heading);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: theme(colors.accent-orange);
  }
</style>
