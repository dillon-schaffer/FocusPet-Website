---
import Card from "../ui/Card.astro";

const points = [
  {
    title: "💻 Built for your desktop",
    description: "Most focus apps live on your phone. Focus Pet is built for your computer, where most distractions actually happen.",
  },
  {
    title: "⚡ Distractions have real consequences",
    description: "Unlike most gamified focus apps, distractions actually affect your rewards. Every distraction reduces the Energy you earn for that session, encouraging you to stay focused.",
  },
  {
    title: "🌿 Gentle motivation that works",
    description: "Stay focused to earn Energy and unlock new decorations. Every session helps you build a cozy world alongside your capybara.",
  },
  {
    title: "🏡 A companion, not a responsibility",
    description: "No hunger bars, friendship meters, or streak punishment. Your capybara quietly keeps you company while you focus.",
  },
];
---

<section id="why-different" class="mx-auto max-w-6xl px-6 py-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold md:text-4xl">Why Focus Pet feels different</h2>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2">
    {points.map((point) => (
      <Card class="text-left">
        <span class="text-3xl" aria-hidden="true">{point.icon}</span>
        <h3 class="mt-3 text-lg font-bold">{point.title}</h3>
        <p class="mt-2 text-text-secondary">{point.description}</p>
      </Card>
    ))}
  </div>
</section>
