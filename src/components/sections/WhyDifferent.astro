---
const thesis = "Most focus apps try to guilt you into working. Focus Pet just hangs out while you do.";

const points = [
  {
    title: "Built for your desktop",
    description:
      "Most focus apps live on your phone. Focus Pet lives on your desktop, where your distractions actually are.",
  },
  {
    title: "Your focus affects the game",
    description:
      "Staying focused earns more Energy. Getting distracted earns less, so your progress reflects how well you stayed on task.",
  },
  {
    title: ""Your progress has a purpose",
    description:
      "Use the Energy you earn to decorate your backyard, unlock new areas, and slowly build a space that's uniquely yours.",
  },
  {
    title: "No streaks or daily pressure",
    description:
      "Focus Pet rewards the work you do instead of punishing the days you don't. Come back whenever you're ready.",
  },
];
---

<section id="why-different" class="mx-auto max-w-5xl px-6 py-20 md:py-28">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold md:text-4xl">Why Focus Pet feels different</h2>
    <p class="mt-5 text-xl text-text-primary md:text-2xl">{thesis}</p>
  </div>

  <div class="why-stack-wrap relative mt-12">
    <svg
      class="why-stack-watermark"
      data-why-stack-watermark
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <ellipse cx="12" cy="15.5" rx="5.2" ry="4.3" />
      <ellipse cx="5.6" cy="9.6" rx="2.1" ry="2.6" transform="rotate(-18 5.6 9.6)" />
      <ellipse cx="10.2" cy="6.2" rx="2.1" ry="2.7" transform="rotate(-6 10.2 6.2)" />
      <ellipse cx="14.8" cy="6" rx="2.1" ry="2.7" transform="rotate(6 14.8 6)" />
      <ellipse cx="18.9" cy="9.2" rx="2.1" ry="2.6" transform="rotate(18 18.9 9.2)" />
    </svg>

    {points.map((point, index) => (
      <article class="why-stack-item" data-why-stack-item>
        <div
          class="why-stack-panel mx-auto flex w-full max-w-2xl items-center gap-5 rounded-card bg-surface p-7 shadow-soft md:min-h-[15rem] md:p-10"
          data-why-stack-panel
          style={`z-index: ${index + 1};`}
        >
          <span class="why-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3 class="font-heading text-lg font-bold md:text-xl">{point.title}</h3>
            <p class="mt-2 text-text-secondary md:text-lg">{point.description}</p>
          </div>
        </div>
      </article>
    ))}
    <div data-why-stack-end aria-hidden="true"></div>
  </div>
</section>

<style>
  .why-number {
    flex-shrink: 0;
    font-family: theme(fontFamily.heading);
    font-weight: 800;
    font-size: 1.75rem;
    line-height: 1;
    color: theme(colors.accent-orange);
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }

  .why-stack-item {
    margin-bottom: 1.5rem;
  }

  .why-stack-item:last-child {
    margin-bottom: 0;
  }

  .why-stack-panel {
    will-change: transform;
    transform-origin: center center;
    transition: box-shadow 0.25s ease;
  }

  .why-stack-panel:hover {
    box-shadow: 0 20px 45px rgba(91, 59, 42, 0.16);
  }

  .why-stack-panel:hover .why-number {
    opacity: 0.85;
  }

  .why-stack-watermark {
    position: absolute;
    top: -2rem;
    left: 50%;
    z-index: 0;
    height: 22rem;
    width: 22rem;
    margin-left: -11rem;
    color: theme(colors.accent-orange);
    opacity: 0.05;
    pointer-events: none;
    will-change: transform;
  }

  @media (max-width: 767px) {
    .why-stack-watermark {
      display: none;
    }
  }
</style>

<script>
  function initWhyStack() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-why-stack-panel]"));
    const endMarkerEl = document.querySelector<HTMLElement>("[data-why-stack-end]");
    const watermark = document.querySelector<HTMLElement>("[data-why-stack-watermark]");
    if (cards.length === 0 || !endMarkerEl) return;
    const endMarker = endMarkerEl;

    const desktopQuery = window.matchMedia("(min-width: 768px)");
    const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

    const STACK_POSITION = 160; // px from top where a card locks into place
    const SCALE_END_POSITION = 40; // px from top where the shrink finishes
    const ITEM_STACK_DISTANCE = 22; // px each subsequent card sits lower than the last
    const BASE_SCALE = 0.92; // final scale of the first card once fully covered
    const ITEM_SCALE = 0.02; // scale increment per card index
    const MAX_BURIED_TILT = 2.5; // deg, how far a card tilts as it gets buried
    const HOVER_LIFT = 6; // px extra lift on hover
    const HOVER_SCALE_BOOST = 0.03; // extra scale on hover

    let cardTops: number[] = [];
    let sectionTop = 0;
    let endTop = 0;
    let ticking = false;
    let hoveredIndex = -1;

    function measure() {
      cardTops = cards.map((card) => card.getBoundingClientRect().top + window.scrollY);
      sectionTop = cardTops[0] ?? 0;
      endTop = endMarker.getBoundingClientRect().top + window.scrollY;
    }

    function reset() {
      cards.forEach((card) => {
        card.style.transform = "";
      });
      if (watermark) watermark.style.transform = "";
    }

    function update() {
      if (!desktopQuery.matches || reduceMotionQuery.matches) {
        reset();
        ticking = false;
        return;
      }

      const scrollY = window.scrollY;
      const pinEnd = endTop - window.innerHeight / 2;

      cards.forEach((card, i) => {
        const cardTop = cardTops[i];
        const stackOffset = STACK_POSITION + ITEM_STACK_DISTANCE * i;
        const triggerStart = cardTop - stackOffset;
        const triggerEnd = cardTop - SCALE_END_POSITION;

        const scaleProgress =
          scrollY < triggerStart
            ? 0
            : scrollY > triggerEnd
              ? 1
              : (scrollY - triggerStart) / (triggerEnd - triggerStart);
        const targetScale = BASE_SCALE + i * ITEM_SCALE;
        let scale = 1 - scaleProgress * (1 - targetScale);
        const tilt = (i % 2 === 0 ? -1 : 1) * scaleProgress * MAX_BURIED_TILT;

        let translateY = 0;
        if (scrollY >= triggerStart && scrollY <= pinEnd) {
          translateY = scrollY - cardTop + stackOffset;
        } else if (scrollY > pinEnd) {
          translateY = pinEnd - cardTop + stackOffset;
        }

        if (i === hoveredIndex) {
          translateY -= HOVER_LIFT;
          scale = Math.min(1, scale + HOVER_SCALE_BOOST);
        }

        card.style.transform = `translate3d(0, ${translateY}px, 0) scale(${scale}) rotate(${tilt}deg)`;
      });

      if (watermark) {
        const drift = (scrollY - sectionTop) * 0.04;
        watermark.style.transform = `translate3d(0, ${drift}px, 0)`;
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }

    function onResize() {
      measure();
      onScroll();
    }

    cards.forEach((card, i) => {
      card.addEventListener("mouseenter", () => {
        hoveredIndex = i;
        requestAnimationFrame(update);
      });
      card.addEventListener("mouseleave", () => {
        if (hoveredIndex === i) hoveredIndex = -1;
        requestAnimationFrame(update);
      });
    });

    measure();
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWhyStack);
  } else {
    initWhyStack();
  }
</script>
