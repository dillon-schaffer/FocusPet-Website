---
import Card from "../ui/Card.astro";

const points = [
  {
    icon: "🛋️",
    title: "A companion, not a chore",
    description: "No hunger bars, friendship meters, or streak punishment. Your pet quietly rests beside you while you focus.",
  },
  {
    icon: "🏡",
    title: "Build a cozy world",
    description: "Earn Energy, collect decorations, unlock new areas, and slowly build a space that feels uniquely yours.",
  },
  {
    icon: "🎯",
    title: "Built for real focus",
    description: "Website blocking, app blocking, focus timers, and Deep Focus help you stay on task without unnecessary complexity.",
  },
  {
    icon: "🔒",
    title: "Local-first by design",
    description: "Focus Pet works completely offline. Your progress is saved locally, with optional cloud sync whenever you want it.",
  },
];
---

<section id="why-different" class="mx-auto max-w-6xl px-6 py-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-extrabold md:text-4xl">Why Focus Pet feels different</h2>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-2">
    {points.map((point) => (
      <Card class="text-left">
        <span class="text-3xl" aria-hidden="true">{point.icon}</span>
        <h3 class="mt-3 text-lg font-bold">{point.title}</h3>
        <p class="mt-2 text-text-secondary">{point.description}</p>
      </Card>
    ))}
  </div>
</section>
